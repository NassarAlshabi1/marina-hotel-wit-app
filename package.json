{
  "name": "marina-hotel-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for Marina Hotel management system",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:expenses": "npx playwright test tests/expenses --reporter=line",
    "install:playwright": "npx playwright install --with-deps",
    "appwrite:setup": "node scripts/appwrite/unified_appwrite_setup.js",
    "appwrite:verify": "node scripts/appwrite/unified_appwrite_setup.js --verify",
    "appwrite:check": "node scripts/appwrite/test_unified_schema.js",
    "appwrite:make-optional": "node scripts/appwrite/unified_appwrite_setup.js --make-optional",
    "appwrite:repair-types": "node scripts/appwrite/unified_appwrite_setup.js --fix-types --confirm",
    "appwrite:prune": "node scripts/appwrite/unified_appwrite_setup.js --prune --confirm",
    "appwrite:create": "npm run appwrite:setup",
    "appwrite:indexes": "npm run appwrite:setup",
    "appwrite:mobile-indexes": "npm run appwrite:setup",
    "appwrite:sync-logs": "npm run appwrite:setup",
    "appwrite:list": "node scripts/appwrite/list_appwrite_collections.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "node-appwrite": "^20.3.0"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "tar": "^7.5.16",
    "ws": "^8.21.0",
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/core": "^2.8.0"
  }
}
