{
  "name": "marina-hotel-e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for Marina Hotel management system",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:expenses": "npx playwright test tests/expenses --reporter=line",
    "install:playwright": "npx playwright install --with-deps",
    "appwrite:setup": "node scripts/appwrite/unified_appwrite_setup.js",
    "appwrite:verify": "node scripts/appwrite/unified_appwrite_setup.js --verify",
    "appwrite:create": "node scripts/appwrite/create_appwrite_collections.js",
    "appwrite:indexes": "node scripts/appwrite/create_unique_indexes.js",
    "appwrite:mobile-indexes": "node scripts/appwrite/create_mobile_indexes.js",
    "appwrite:sync-logs": "node scripts/appwrite/ensure_sync_logs_action.js",
    "appwrite:list": "node scripts/appwrite/list_appwrite_collections.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.195.0",
    "node-appwrite": "^20.3.0"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "tar": "^7.5.21",
    "ws": "^8.21.0",
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "axios": "^1.16.0",
    "form-data": "^4.0.4",
    "minimatch": "^10.2.3",
    "picomatch": "^4.0.4",
    "shell-quote": "^1.9.0",
    "linkify-it": "^5.0.2",
    "fast-xml-parser": "^5.7.0",
    "brace-expansion": "^5.0.8",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4"
  }
}