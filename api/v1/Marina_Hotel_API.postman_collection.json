{
  "info": {
    "name": "Marina Hotel API v1",
    "description": "Complete REST API for Marina Hotel Management System",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/marina-hotel-wit-app/api/v1",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data.token) {",
                  "        pm.collectionVariables.set('auth_token', jsonData.data.token);",
                  "        console.log('Token saved:', jsonData.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "login.php"]
            }
          }
        },
        {
          "name": "Ping",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/ping.php",
              "host": ["{{base_url}}"],
              "path": ["auth", "ping.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health.php",
          "host": ["{{base_url}}"],
          "path": ["health.php"]
        }
      }
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Pull Changes",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/sync/pull.php?since=0",
              "host": ["{{base_url}}"],
              "path": ["sync", "pull.php"],
              "query": [{"key": "since", "value": "0"}]
            }
          }
        },
        {
          "name": "Push Changes",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changes\": [\n    {\n      \"entity\": \"rooms\",\n      \"action\": \"create\",\n      \"local_uuid\": \"test-uuid-123\",\n      \"data\": {\n        \"roomNumber\": \"999\",\n        \"roomType\": \"standard\",\n        \"price\": 100.0,\n        \"status\": \"شاغرة\",\n        \"cleaningStatus\": \"clean\"\n      }\n    }\n  ]\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/sync/push.php",
              "host": ["{{base_url}}"],
              "path": ["sync", "push.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "List Rooms",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/rooms.php?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["entities", "rooms.php"],
              "query": [{"key": "page", "value": "1"}, {"key": "page_size", "value": "10"}]
            }
          }
        },
        {
          "name": "Get Room",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/rooms.php/1",
              "host": ["{{base_url}}"],
              "path": ["entities", "rooms.php", "1"]
            }
          }
        },
        {
          "name": "Create Room",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_number\": \"101\",\n  \"type\": \"standard\",\n  \"price\": 150.0,\n  \"status\": \"شاغرة\",\n  \"cleaning_status\": \"clean\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/entities/rooms.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "rooms.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/bookings.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "bookings.php"]
            }
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_number\": \"101\",\n  \"guest_name\": \"أحمد محمد\",\n  \"guest_phone\": \"777123456\",\n  \"guest_nationality\": \"يمني\",\n  \"checkin_date\": \"2024-02-01\",\n  \"status\": \"محجوزة\",\n  \"expected_nights\": 3\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/entities/bookings.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "bookings.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/employees.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "employees.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "List Payments",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/payments.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "payments.php"]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "List Expenses",
          "request": {
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]},
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/entities/expenses.php",
              "host": ["{{base_url}}"],
              "path": ["entities", "expenses.php"]
            }
          }
        }
      ]
    }
  ]
}
