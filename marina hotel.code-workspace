{
        "folders": [
                {
                        "path": "."
                }
        ],
        "settings": {
                "ocaml.sandbox": {
                        "kind": "custom",
                        "template": "$prog $args"
                },
                "terminal.integrated.sendKeybindingsToShell": true,
                "quokka.codeClipAutoUpload": true,
                "quokka.automaticRestart": true,
                "java.configuration.updateBuildConfiguration": "disabled",
                "workbench.editor.autoLockGroups": {
                        "workbench.editorinputs.searchEditorInput": true,
                        "windsurf.workflowEditor": true
                },
                "workbench.editor.defaultBinaryEditor": "windsurf.workflowEditor"
        },
        "extensions": {
                "recommendations": [
                        "tabnine.tabnine-vscode-self-hosted-updater"
                ]
        }
}