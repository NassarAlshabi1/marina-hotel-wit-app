{
  "name": "marina-hotel-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute marina-hotel-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute marina-hotel-db --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0002_inventory_blacklist.sql",
    "db:migrate:app-users": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0003_app_users.sql",
    "db:migrate:devices": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0004_devices_sync.sql",
    "db:migrate:parity": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0005_schema_parity.sql",
    "db:migrate:salary-uuid-1": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0006_salary_withdrawals_employee_uuid.sql",
    "db:migrate:salary-uuid-2": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0007_salary_tables_employee_uuid.sql",
    "db:migrate:idempotency-idx": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0008_idempotency_log_cleanup.sql",
    "db:migrate:finance": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0009_finance_snapshots.sql",
    "db:migrate:finance:remote": "wrangler d1 execute marina-hotel-db --remote --file=./migrations/0009_finance_snapshots.sql",
    "db:migrate:sync-meta": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0010_sync_meta.sql",
    "db:migrate:portable-financial": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0011_portable_financial_relationships.sql",
    "db:migrate:expense-link-clear-flag": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0012_expense_employee_link_clear_flag.sql",
    "db:migrate:salary-expense-uuid": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0013_salary_withdrawal_expense_uuid.sql",
    "db:migrate:write-times": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0014_sync_write_times.sql",
    "db:migrate:expense-kind": "wrangler d1 execute marina-hotel-db --local --file=./migrations/0015_expense_kind.sql",
    "db:migrate:remote": "wrangler d1 execute marina-hotel-db --remote --file=./migrations/0009_finance_snapshots.sql",
    "db:migrate:remote:full": "wrangler d1 execute marina-hotel-db --remote --file=./migrations/0002_inventory_blacklist.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0003_app_users.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0004_devices_sync.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0005_schema_parity.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0006_salary_withdrawals_employee_uuid.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0007_salary_tables_employee_uuid.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0008_idempotency_log_cleanup.sql && wrangler d1 execute marina-hotel-db --remote --file=./migrations/0009_finance_snapshots.sql",
    "db:tables:remote": "wrangler d1 execute marina-hotel-db --remote --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260916.1",
    "typescript": "^5.7.2",
    "vitest": "~2.1.9",
    "wrangler": "^4.133.0"
  },
  "allowScripts": {
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "workerd@1.20260916.1": true,
    "workerd@1.20260310.1": true,
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.3": true,
    "sharp@0.33.5": true,
    "sharp@0.34.5": true
  }
}
