{
  "name": "marina-hotel-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute marina-hotel-db --file=./schema.sql",
    "db:migrate": "wrangler d1 execute marina-hotel-db --file=./migrations/0002_inventory_blacklist.sql",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "vitest": "~2.1.9",
    "wrangler": "^3.94.0"
  },
  "dependencies": {},
  "allowScripts": {
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
