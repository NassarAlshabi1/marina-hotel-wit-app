# ═══════════════════════════════════════════════════════════════
#  Marina Hotel — FCM Notifier Appwrite Function
#  Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# ⚠️ لا تضع القيم الحقيقية هنا! هذا ملف قالب فقط.
# القيم الحقيقية تُعيين في Appwrite Console → Settings → Variables.
#
# انسخ هذا الملف إلى .env للاختبار المحلي فقط (لا تُcommit .env).

# Appwrite
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_FUNCTION_PROJECT_ID=6a2b01d0000752ce97e7
APPWRITE_API_KEY=standard_your_api_key_here
APPWRITE_DATABASE_ID=6a2b030d000445596163
APPWRITE_DEVICES_COLLECTION=devices

# Firebase Admin SDK (من serviceAccount.json)
FIREBASE_PROJECT_ID=aden-flutter
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aden-flutter.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
