<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/summaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Marina.H2"
            tools:text="15 أكتوبر 2025" />

        <TextView
            android:id="@+id/summaryOccupancy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Marina.Body"
            android:textColor="@color/color_text_secondary"
            tools:text="الإشغال: ‎75%" />

        <TextView
            android:id="@+id/summaryRevenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Marina.Body"
            android:textColor="@color/color_success"
            tools:text="الإيرادات: 4,500 ر.س" />

        <TextView
            android:id="@+id/summaryExpenses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Marina.Body"
            android:textColor="@color/color_error"
            tools:text="المصروفات: 1,200 ر.س" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
