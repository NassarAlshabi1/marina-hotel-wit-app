diff --git a/mobile/lib/main.dart b/mobile/lib/main.dart
index 8f52ef8e..db01e98a 100755
--- a/mobile/lib/main.dart
+++ b/mobile/lib/main.dart
@@ -466,13 +466,20 @@ class _AppState extends ConsumerState<App> with WidgetsBindingObserver {
         // الفشل الصامت إلى Full Sync متكرر.
 
         // ✅ Cloudflare migration: push local data to D1 on first run
-        if (!await CloudflareMigrationService.instance.isMigrationComplete()) {
+        // ✅ (2026-10-03) CF-4: لا `!` على token/deviceId — كان null عند أول
+        // تشغيل يرمي استثناءً ويُبقي العلم غير معلَّم فيُعاد الترحيل لاحقاً.
+        // الترحيل نفسه صار INSERT OR IGNORE (لا كتابة فوق بيانات D1).
+        final migrationToken = syncManager.token;
+        final migrationDeviceId = AppwriteSyncManager.currentDeviceIdStatic;
+        if (migrationToken != null &&
+            migrationDeviceId != null &&
+            !await CloudflareMigrationService.instance.isMigrationComplete()) {
           debugPrint('🔄 Starting Cloudflare migration...');
           try {
             final result = await CloudflareMigrationService.instance.migrate(
               db: DatabaseManager.instance,
-              token: syncManager.token!,
-              deviceId: AppwriteSyncManager.currentDeviceIdStatic!,
+              token: migrationToken,
+              deviceId: migrationDeviceId,
             );
             debugPrint(
               '🔄 Migration: ${result.totalPushed}/${result.totalRecords} pushed, ${result.totalFailed} failed',
diff --git a/mobile/lib/services/cloudflare_migration_service.dart b/mobile/lib/services/cloudflare_migration_service.dart
index e4311524..06f61d65 100755
--- a/mobile/lib/services/cloudflare_migration_service.dart
+++ b/mobile/lib/services/cloudflare_migration_service.dart
@@ -326,7 +326,11 @@ class CloudflareMigrationService {
   }
 
   /// Build a SQL INSERT statement with multiple VALUES from a batch of records.
-  /// Uses INSERT OR REPLACE for idempotent re-runs (unique local_uuid).
+  /// ✅ (2026-10-03) CF-4: INSERT OR IGNORE (كان INSERT OR REPLACE).
+  /// REPLACE = حذف + إدراج في D1: يكتب فوق تعديلات أحدث من أجهزة أخرى،
+  /// ويمسح أعمدة الخادم، وعلى `salary_cycles` (UNIQUE(employee_id,
+  /// cycle_key)) يحذف دورة موظف آخر يتصادف رقمه المحلي. IGNORE يُدرج
+  /// فقط ما ليس في D1 — إعادة التشغيل تبقى آمنة (idempotent) دون كتابة فوق.
   /// All values are properly SQL-escaped to prevent injection.
   /// Fills NOT NULL columns (without defaults) with empty values to prevent
   /// silent constraint violations.
@@ -417,7 +421,7 @@ class CloudflareMigrationService {
       valuesClauses.add('(${values.join(', ')})');
     }
 
-    return 'INSERT OR REPLACE INTO $tableName ($columnsStr) VALUES\n'
+    return 'INSERT OR IGNORE INTO $tableName ($columnsStr) VALUES\n'
         '${valuesClauses.join(',\n')};';
   }
 
diff --git a/mobile/test/cloudflare_migration_service_test.dart b/mobile/test/cloudflare_migration_service_test.dart
index d1fcbb9b..06d3733f 100755
--- a/mobile/test/cloudflare_migration_service_test.dart
+++ b/mobile/test/cloudflare_migration_service_test.dart
@@ -3,6 +3,8 @@
 //  Tests for CloudflareMigrationService (SQL building, batch logic)
 // ═══════════════════════════════════════════════════════════════
 
+import 'dart:io';
+
 import 'package:flutter_test/flutter_test.dart';
 import 'package:marina_hotel_mobile/services/cloudflare_migration_service.dart';
 
@@ -35,6 +37,21 @@ void main() {
     });
   });
 
+  group('CF-4: الترحيل لا يكتب فوق بيانات D1', () {
+    test('عبارة الترحيل INSERT OR IGNORE لا INSERT OR REPLACE', () {
+      final src = File(
+        'lib/services/cloudflare_migration_service.dart',
+      ).readAsStringSync();
+      expect(src, contains("'INSERT OR IGNORE INTO \$tableName"));
+      expect(src, isNot(contains("'INSERT OR REPLACE INTO \$tableName")));
+    });
+
+    test('main.dart لا يستخدم ! على token/deviceId عند الترحيل', () {
+      final src = File('lib/main.dart').readAsStringSync();
+      expect(src, isNot(contains('token: syncManager.token!')));
+    });
+  });
+
