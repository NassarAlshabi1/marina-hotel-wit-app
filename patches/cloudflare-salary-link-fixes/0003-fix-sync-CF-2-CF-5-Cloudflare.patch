+// ═══════════════════════════════════════════════════════════════
+//  cloudflare_salary_fk_protection_test.dart
+//  (2026-10-03) CF-2 / CF-5 — حل روابط الرواتب في سحب Cloudflare بلا تخمين.
+//
+//  الخلفية: employee_id / related_id على السلك = id محلي في جهاز المصدر،
+//  بينما employees.server_id المحلي = id الموظف في D1 (فضاءان مختلفان).
+//  المطابقة بينهما كانت تنسب سحوبات/مصروفات لموظف خاطئ.
+//  انظر docs/CLOUDFLARE_BRANCH_SALARY_LINK_REVIEW.md.
+// ═══════════════════════════════════════════════════════════════
+
+import 'package:drift/drift.dart' hide isNull, isNotNull;
+import 'package:drift/native.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:marina_hotel_mobile/screens/settings/error_tracker_screen.dart';
+import 'package:marina_hotel_mobile/services/cloudflare_sync_manager.dart';
+import 'package:marina_hotel_mobile/services/local_db.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+class _NoNetworkClient extends http.BaseClient {
+  @override
+  Future<http.StreamedResponse> send(http.BaseRequest request) =>
+      throw StateError('no network in this test: ${request.url}');
+}
+
+Map<String, dynamic> _sync(
+  String uuid, {
+  int? wireId,
+  int updatedAt = 1700000500,
+}) => {
+  'id': wireId,
+  'local_uuid': uuid,
+  'created_at': updatedAt,
+  'updated_at': updatedAt,
+  'last_modified': updatedAt,
+  'created_at_epoch': 0,
+  'last_modified_epoch': 0,
+  'version': 1,
+  'origin': 'local',
+  'vector_clock': '{}',
+  'device_id': 'other-device',
+};
+
+Map<String, dynamic> _withdrawal(
+  String uuid, {
+  required int employeeId,
+  String? employeeUuid,
+  int updatedAt = 1700000500,
+  int version = 1,
+}) => {
+  ..._sync(uuid, wireId: 900, updatedAt: updatedAt),
+  'version': version,
+  'employee_id': employeeId,
+  'employee_uuid': employeeUuid,
+  'amount': 5000.0,
+  'withdraw_date': '2026-10-01',
+  'reason': 'exp_42',
+  'hotel_day_key': '2026-10-01',
+  'withdrawal_type': 'سحب راتب',
+  'description': 'test',
+};
+
+Map<String, dynamic> _expense(
+  String uuid, {
+  required String type,
+  int? relatedId,
+  String? employeeUuid,
+  int updatedAt = 1700000500,
+  int version = 1,
+}) => {
+  ..._sync(uuid, wireId: 700, updatedAt: updatedAt),
+  'version': version,
+  'expense_type': type,
+  'related_id': relatedId,
+  'employee_uuid': employeeUuid,
+  'description': 'test',
+  'amount': 15000.0,
+  'date': '2026-10-01',
+  'hotel_day_key': '2026-10-01',
+  'is_auto_generated': 0,
+};
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  late AppDatabase db;
+  late CloudflareSyncManager manager;
+
+  Future<int> insertEmployee(String uuid, {int? serverId}) => db
+      .into(db.employees)
+      .insert(
+        EmployeesCompanion(
+          name: Value('موظف $uuid'),
+          basicSalary: const Value(100000),
+          status: const Value('active'),
+          localUuid: Value(uuid),
+          serverId: Value(serverId),
+          createdAt: const Value(1000),
+          updatedAt: const Value(1000),
+          lastModified: const Value(1000),
+        ),
+      );
+
+  Future<SalaryWithdrawal?> withdrawal(String uuid) => (db.select(
+    db.salaryWithdrawals,
+  )..where((t) => t.localUuid.equals(uuid))).getSingleOrNull();
+
+  Future<Expense?> expense(String uuid) => (db.select(
+    db.expenses,
+  )..where((t) => t.localUuid.equals(uuid))).getSingleOrNull();
+
+  // ملاحظة: _fkParentIdCache في المدير (singleton) لا يُصفَّر بين الاختبارات،
+  // لذلك كل اختبار يستخدم UUIDs فريدة للموظفين.
+  setUp(() {
+    SharedPreferences.setMockInitialValues(<String, Object>{
+      'cloudflare_sync_local_override': true,
+    });
+    ErrorTrackerStore.instance.clear();
+    db = AppDatabase.forTesting(NativeDatabase.memory());
+    manager = CloudflareSyncManager();
+    manager.reset();
+    manager.configureForTesting(
+      database: db,
+      httpClient: _NoNetworkClient(),
+      token: 'test-token',
+      deviceId: 'fk-protection-device',
+    );
+  });
+
+  tearDown(() async {
+    await db.close();
+  });
+
+  group('CF-2: salary_withdrawals.employee_id', () {
+    test('UUID موجود وغير محلول → يُؤجَّل ولا يسقط إلى server_id', () async {
+      // موظف محلي آخر يتصادف server_id (id في D1) مع رقم جهاز المصدر.
+      await insertEmployee('emp-other', serverId: 5);
+
+      final report = await manager.applyPulledRecords([
+        (
+          entity: 'salary_withdrawals',
+          record: _withdrawal(
+            'sw-uuid-missing',
+            employeeId: 5,
+            employeeUuid: 'emp-not-pulled-yet',
+          ),
+        ),
+      ]);
+
+      expect(report.appliedCount, 0);
+      expect(await withdrawal('sw-uuid-missing'), isNull);
+    });
+
+    test('UUID محلول → يُربط بالموظف الصحيح رغم رقم مختلف', () async {
+      await insertEmployee('emp-other', serverId: 5);
+      final right = await insertEmployee('emp-right', serverId: 77);
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'salary_withdrawals',
+          record: _withdrawal(
+            'sw-uuid-ok',
+            employeeId: 5,
+            employeeUuid: 'emp-right',
+          ),
+        ),
+      ]);
+
+      expect((await withdrawal('sw-uuid-ok'))!.employeeId, right);
+    });
+
+    test('بلا UUID و server_id مكرر محلياً → لا تخمين', () async {
+      await insertEmployee('emp-dup-1', serverId: 10);
+      await insertEmployee('emp-dup-2', serverId: 10);
+
+      final report = await manager.applyPulledRecords([
+        (
+          entity: 'salary_withdrawals',
+          record: _withdrawal('sw-ambiguous', employeeId: 10),
+        ),
+      ]);
+
+      expect(report.appliedCount, 0);
+      expect(await withdrawal('sw-ambiguous'), isNull);
+    });
+
+    test('صف موجود: مطابقة server_id بلا UUID لا تكتب فوق ربطه', () async {
+      final a = await insertEmployee('emp-a', serverId: 1);
+      await insertEmployee('emp-b', serverId: 7);
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'salary_withdrawals',
+          record: _withdrawal(
+            'sw-existing',
+            employeeId: 1,
+            employeeUuid: 'emp-a',
+          ),
+        ),
+      ]);
+      expect((await withdrawal('sw-existing'))!.employeeId, a);
+
+      // تحديث لاحق بلا UUID، ورقمه يطابق server_id موظف آخر.
+      await manager.applyPulledRecords([
+        (
+          entity: 'salary_withdrawals',
+          record: _withdrawal(
+            'sw-existing',
+            employeeId: 7,
+            updatedAt: 1700000900,
+            version: 2,
+          ),
+        ),
+      ]);
+      expect((await withdrawal('sw-existing'))!.employeeId, a);
+    });
+  });
+
+  group('CF-5: expenses.related_id', () {
+    test('سلفة بلا UUID → related_id = NULL لا الرقم الخام', () async {
+      final local = await insertEmployee('emp-local');
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'expenses',
+          record: _expense('exp-advance', type: 'سلفة', relatedId: local),
+        ),
+      ]);
+
+      final row = await expense('exp-advance');
+      expect(row, isNotNull);
+      expect(row!.relatedId, isNull);
+    });
+
+    test('سلفة بـ UUID محلول → الموظف الصحيح', () async {
+      final right = await insertEmployee('emp-right-advance');
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'expenses',
+          record: _expense(
+            'exp-advance-ok',
+            type: 'سلفة',
+            relatedId: 999,
+            employeeUuid: 'emp-right-advance',
+          ),
+        ),
+      ]);
+
+      expect((await expense('exp-advance-ok'))!.relatedId, right);
+    });
+
+    test('تحديث بلا UUID لا يمسح ربطاً محلياً صحيحاً', () async {
+      final a = await insertEmployee('emp-a');
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'expenses',
+          record: _expense(
+            'exp-keep',
+            type: 'سحب راتب',
+            relatedId: 1,
+            employeeUuid: 'emp-a',
+          ),
+        ),
+      ]);
+      expect((await expense('exp-keep'))!.relatedId, a);
+
+      await manager.applyPulledRecords([
+        (
+          entity: 'expenses',
+          record: _expense(
+            'exp-keep',
+            type: 'سحب راتب',
+            relatedId: 999,
+            updatedAt: 1700000900,
+            version: 2,
+          ),
+        ),
+      ]);
+      expect((await expense('exp-keep'))!.relatedId, a);
+    });
+
+    test('مصروف عام يحتفظ بـ related_id كما هو', () async {
+      await manager.applyPulledRecords([
+        (
+          entity: 'expenses',
+          record: _expense('exp-general', type: 'صيانة', relatedId: 42),
+        ),
+      ]);
+      expect((await expense('exp-general'))!.relatedId, 42);
+    });
+  });
+}
