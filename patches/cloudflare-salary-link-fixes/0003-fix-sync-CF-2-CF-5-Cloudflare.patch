+  Future<Object?> _lookupUniqueLocalParentId(
+    String parentTable,
+    String keyColumn,
+    Object? keyValue,
+  ) async {
+    try {
+      final rows = await _db!
+          .customSelect(
+            'SELECT id FROM $parentTable WHERE $keyColumn = ? LIMIT 2',
+            variables: [Variable(keyValue)],
+          )
+          .get();
+      if (rows.length != 1) {
+        if (rows.length > 1) {
+          _logFkOnce(
+            'ambiguous $parentTable.$keyColumn=$keyValue — no guess',
+          );
+        }
+        return null;
+      }
+      return rows.single.data['id'] as Object?;
+    } catch (e) {
+      _logFkOnce('parent lookup failed $parentTable.$keyColumn: $e');
+      return null;
+    }
+  }
