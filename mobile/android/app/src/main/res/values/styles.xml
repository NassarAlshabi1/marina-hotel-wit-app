<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Consistent light window/splash fallback before Compose applies the saved theme. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/marina_canvas</item>
        <item name="android:navigationBarColor">@color/marina_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/marina_canvas</item>
        <item name="android:statusBarColor">@color/marina_canvas</item>
        <item name="android:navigationBarColor">@color/marina_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
