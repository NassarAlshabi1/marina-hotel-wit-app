<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. The app is pure Jetpack Compose; this XML
         theme is only the window container before the Compose tree mounts. -->
    <style name="Theme.MarinaHotel" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/marina_canvas</item>
        <item name="android:navigationBarColor">@color/marina_navigation_legacy</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.MarinaHotel.NoActionBar" parent="Theme.MarinaHotel">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
