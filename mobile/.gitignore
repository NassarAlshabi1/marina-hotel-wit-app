# F4D1 Reference: https://github.com/github/gitignore/blob/main/Flutter.gitignore

# ============================================
# FLUTTER SPECIFIC
# ============================================

# Flutter build outputs
/build/**
.dart_tool/**

# Flutter IDE specific
.idea/**
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/**
*.code-workspace

# Android Studio
*.swp
*.swo
*~

# ============================================
# ANDROID
# ============================================

# Android build outputs
android/.idea/**
android/build/**
android/captures/**
android/gradlew
android/gradlew.bat
android/local.properties
android/**/build/**
android/**/generated/**
android/**/*.dex
android/**/*.class
android/**/*.jar
android/**/*.so
android/**/*.apk
android/**/*.aab
android/**/*.jks
android/**/*.keystore
android/**/*.pem
android/**/*.pk8
android/**/*.p12
android/**/play-services.json

# Android log files
android/logs/**
android/*.log

# Android test outputs
android/**/androidTest/**
android/**/test/**

# ============================================
# IOS
# ============================================

# iOS build outputs
ios/.idea/**
ios/build/**
ios/DerivedData/**
ios/*.pbxuser
ios/*.mode1v3
ios/*.mode2v3
ios/*.perspectivev3
ios/*.xcworkspace
ios/*.xcodeproj
ios/*.xcsettings
ios/*.xcsettings.plist
ios/Pods/**
ios/Podfile.lock
ios/Podfile.local.json
ios/Flutter/ephemeral/**
ios/.symlinks/**
ios/Profile.data
ios/exportOptions.plist

# iOS certificates and provisioning profiles
ios/*.cer
ios/*.p12
ios/*.mobileprovision
ios/*.pem
ios/*.key

# ============================================
# WEB
# ============================================

# Web build outputs
web/build/**
web/.idea/**
web/.next/**
web/out/**
web/dist/**
web/.parcel-cache/**

# ============================================
# WINDOWS
# ============================================

# Windows build outputs
windows/.idea/**
windows/build/**
windows/runner/Debug/**
windows/runner/Release/**
windows/*.user
windows/*.userosscache
windows/*.sln.docstates

