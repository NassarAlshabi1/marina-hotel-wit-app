macos/build/**
macos/DerivedData/**
macos/*.pbxuser
macos/*.mode1v3
macos/*.mode2v3
macos/*.perspectivev3
macos/*.xcworkspace
macos/*.xcodeproj
macos/*.xcsettings
macos/*.xcsettings.plist
