# ============================================
# LINUX
# ============================================

# Linux build outputs
linux/.idea/**
linux/build/**
linux/*.user
linux/*.userosscache

# ============================================
# PUB & DART
# ============================================

# Pub cache
/.pub-cache/**
/pub-cache/**

# Dart SDK
.dart_tool/**

# ============================================
# ENVIRONMENT & SECRETS
# ============================================

# Environment files (NEVER commit these!)
.env
.env.*
!.env.example
!.env.template
!.env.dist

# Firebase configuration
firebase_options.dart
google-services.json
GoogleService-Info.plist

# Appwrite configuration
appwrite.json
appwrite.config.json

# API keys and secrets
*.key
*.pem
*.p12
*.jks
*.keystore
*.pfx
*.cer

# ============================================
# LOGS & TEMPORARY FILES
# ============================================

# Log files
*.log
*.logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
.pid
.pid.lock

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# TESTING
# ============================================

# Test outputs
/test/**/coverage/**
/coverage/**
*.lcov
*.lcov.info

# Test results
/test/**/results/**
/results/**
*.xml
*.json

# Test coverage HTML reports
coverage/html/**

# ============================================
# DEBUG & PROFILING
# ============================================

# Debug symbols
debug_symbols/**
*.symbols
*.debug

# Profiling data
*.trace
*.perf
*.prof

# Crash reports
*.crash
*.stacktrace

# ============================================
# IDE SPECIFIC
# ============================================

# IntelliJ
.idea/**
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/**
*.code-workspace
*.code-profile

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/**
*.atom

# ============================================
# PACKAGE MANAGERS
# ============================================

# Pub
pubspec.lock

# Node (if used for scripts)
node_modules/**
package-lock.json
yarn.lock

# ============================================
# GENERATED FILES
# ============================================

# Freezed generated files (keep in repo for consistency)
!lib/**/*.freezed.dart
!lib/**/*.g.dart

# JSON Serializable generated files
!lib/**/*.g.dart

# Riverpod generated files
!lib/**/*.g.dart

# Drift generated files
!lib/**/*.drift.dart
!lib/**/database.dart
!lib/**/daos.dart

# Mockito generated files
!test/**/*.mocks.dart
!test/**/mocks/**

# Build runner generated files
!generated/**

# ============================================
# DOCUMENTATION
# ============================================

# Keep all documentation files
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!LICENSE
!docs/**

# ============================================
# CONFIGURATION FILES (KEEP THESE)
# ============================================

# Flutter configuration
!pubspec.yaml
!pubspec.lock
!analysis_options.yaml
!build.yaml

# GitHub configuration
!.github/**

# CI/CD configuration
!.gitlab-ci.yml
!.gitignore
!.gitleaks.toml

# Project configuration
!android/local.properties.example
!ios/Config.xcconfig.example

# ============================================
# BACKUP & ARCHIVE FILES
# ============================================

# Backup files
*.bak
*.backup
*.old
*.orig

# Archive files
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ============================================
# OS SPECIFIC
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/**

# Linux
*~
.nfs*

