# Environment Configuration
BASE_API_URL=http://hotelmarina.com/MARINA_HOTEL_PORTABLE/api/v1

# AgentRouter AI (OpenAI-compatible API)
AGENT_ROUTER_API_KEY=your_agent_router_key_here
AGENT_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
