# InfluenceApp
INFLUENCE_APP_ADMIN_PASSWORD=admin
INFLUENCE_APP_ADMIN_EMAIL=admin@admin.com
INFLUENCE_APP_API_KEY=sk-YOUR_API_KEY_HERE
INFLUENCE_APP_BASE_URL=https://your-api-url.com

# Optional Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional WhatsApp CallMeBot
WHATSAPP_PHONE_NUMBER=your_whatsapp_number
WHATSAPP_API_KEY=your_callmebot_key

# Optional WhatsApp GreenAPI
WHATSAPP_API_TOKEN=your_greenapi_token
WHATSAPP_INSTANCE_ID=your_greenapi_instance_id