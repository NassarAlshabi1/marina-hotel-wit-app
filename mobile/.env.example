# ═══════════════════════════════════════════════════════════════
#  Marina Hotel Mobile — Build-time configuration
#  ✅ (2026-09-30) أُعيدت كتابة هذا الملف: النسخة السابقة كانت تشير إلى
#  مشروع آخر (INFLUENCE_APP_*) وإلى ملف .env لا يقرأه أي كود — كل الإعدادات
#  هنا تُمرَّر عبر --dart-define وقت البناء وتُقرأ من lib/utils/env.dart
#  (String.fromEnvironment). لا يوجد تحميل لملف .env في التطبيق.
# ═══════════════════════════════════════════════════════════════
#
# مثال بناء كامل:
#   flutter build apk --release \
#     --dart-define=CLOUDFLARE_WORKER_URL=https://marina-hotel-api.adenmarina2.workers.dev \
#     --dart-define=CLOUDFLARE_RELAY_URL=https://marina-hotel-api-relay.pages.dev \
#     --dart-define=CLOUDFLARE_USERNAME=sync_service \
#     --dart-define=CLOUDFLARE_PASSWORD='<strong-unique-password>' \
#     --dart-define=TELEGRAM_BOT_TOKEN='<bot-token>' \
#     --dart-define=TELEGRAM_CHAT_ID='<chat-id>'
#
# ─── Cloudflare Sync (lib/utils/env.dart) ──────────────────────
# عنوان الـ Worker الأساسي (workers.dev — قد يُحجب في بعض الشبكات).
CLOUDFLARE_WORKER_URL=https://marina-hotel-api.adenmarina2.workers.dev
# جسر pages.dev (SNI مختلف — يتجاوز حجب workers.dev). القيمة الفارغة تعطّله.
CLOUDFLARE_RELAY_URL=https://marina-hotel-api-relay.pages.dev
# ⚠️ أمني: لا تستخدم admin/admin في الإنتاج — أنشئ حساب خدمة مزامنة
# بكلمة قوية عبر POST /api/auth/register (admin فقط) ثم مرّره هنا.
# راجع: mobile/CLOUDFLARE_WORKER_D1_CONNECTION_DIAGNOSIS_2026-09-29.md (البند C1)
CLOUDFLARE_USERNAME=sync_service
CLOUDFLARE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
#
# ─── Telegram (تقارير + تنبيهات) ───────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
#
# ─── WhatsApp CallMeBot (اختياري) ──────────────────────────────
WHATSAPP_PHONE_NUMBER=your_whatsapp_number
WHATSAPP_API_KEY=your_callmebot_key
#
# ─── WhatsApp GreenAPI (اختياري) ───────────────────────────────
WHATSAPP_API_TOKEN=your_greenapi_token
WHATSAPP_INSTANCE_ID=your_greenapi_instance_id
#
# ─── Hotel contact (يظهر في رسائل الديون) ─────────────────────
HOTEL_CONTACT_PHONE=your_phone
#
# ─── AgentRouter AI (اختياري) ──────────────────────────────────
AGENT_ROUTER_API_KEY=your_agent_router_key
AGENT_ROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# ─── FCM direct send (مهمل — يُفضّل Appwrite Function) ────────
# ⚠️ أمني: أي مفتاح هنا يُخبَز داخل APK ويمكن استخراجه منه.
FCM_SERVER_KEY=your_fcm_legacy_server_key
FCM_SERVICE_ACCOUNT_JSON=base64_of_service_account_json
FCM_PROJECT_ID=your_firebase_project_id
#
# ─── PostHog Analytics (اختياري) ───────────────────────────────
POSTHOG_API_KEY=phc_your_key
POSTHOG_HOST=https://us.i.posthog.com
#
# ─── Legacy PHP API (اختياري — للمحاكي/التطوير المحلي) ────────
# محاكي Android: http://10.0.2.2/api/v1 | جهاز حقيقي: IP الحاسوب المحلي
BASE_API_URL=
